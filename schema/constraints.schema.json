{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schema/constraints.schema.json",
  "title": "Muse constraints",
  "description": "Invariants every rendition must satisfy (SCHEMA_SPEC.md §2.5). The conformance contract between composer and engine.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "must_contain": {
      "type": "array",
      "description": "Material ids that must appear recognizably in every rendition.",
      "items": { "type": "string", "minLength": 1 }
    },
    "must_not": {
      "type": "array",
      "description": "Typed predicates every rendition must avoid. Extensible: a predicate is an object with a string `kind`; known kinds carry their own fields. Unknown kinds are preserved for engines that understand them.",
      "items": { "$ref": "#/$defs/predicate" }
    },
    "tempo_lock": {
      "type": "object",
      "description": "Per-section bpm ranges, narrowing globals.tempo.range. Keys are section ids.",
      "additionalProperties": { "$ref": "#/$defs/bpmRange" }
    },
    "tempo_shapes": {
      "type": "object",
      "description": "Per-section tempo-shape constraints (spec §2.5): bounded expressive tempo modification — ritardando, accelerando, rubato — that the performance layer's tempo_map must realize. Keys are section ids.",
      "additionalProperties": { "$ref": "#/$defs/tempoShape" }
    },
    "register": {
      "type": "object",
      "description": "Per-material pitch ranges. Keys are material ids; values are [low, high] pitch bounds.",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          { "$ref": "material.schema.json#/$defs/pitch", "description": "low bound, e.g. C4" },
          { "$ref": "material.schema.json#/$defs/pitch", "description": "high bound, e.g. A5" }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form_deviation": { "type": "string", "enum": ["none", "reorder", "abridge"] }
      }
    }
  },
  "$defs": {
    "bpmRange": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "[min, max] bpm."
    },
    "tempoShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ritardando", "accelerando", "rubato"],
          "description": "rit./accel. change the section tempo monotonically toward `target_bpm`; rubato permits bounded expressive deviation within `deviation_bpm` around the active tempo."
        },
        "target_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "deviation_bpm": { "type": "number", "exclusiveMinimum": 0 },
        "span": {
          "type": "string",
          "enum": ["section", "final_bars", "opening_bars"],
          "description": "Where the shape applies; bar-count scoping uses the section's own bar count. Default: section."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["ritardando", "accelerando"] } } },
          "then": { "required": ["target_bpm"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rubato" } } },
          "then": { "required": ["deviation_bpm"] }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "modulation_beyond" } } },
          "then": {
            "properties": {
              "semitones": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["semitones"]
          }
        }
      ]
    }
  }
}
