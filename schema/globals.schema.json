{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schema/globals.schema.json",
  "title": "Muse globals (spec §2.2)",
  "type": "object",
  "properties": {
    "tempo": {
      "type": "object",
      "properties": {
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "feel": { "type": "string" }
      },
      "required": ["bpm"],
      "additionalProperties": false
    },
    "meter": {
      "type": "object",
      "properties": {
        "beats": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            {
              "type": "array",
              "minItems": 2,
              "items": { "type": "integer", "minimum": 1 }
            }
          ]
        },
        "unit": { "type": "integer", "minimum": 1 }
      },
      "required": ["beats", "unit"],
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "properties": {
        "tonic": { "type": "string" },
        "mode": { "type": "string" }
      },
      "required": ["tonic"],
      "anyOf": [
        { "properties": { "tonic": { "const": "atonal" } } },
        { "required": ["mode"] }
      ],
      "additionalProperties": false
    },
    "duration_bars": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
