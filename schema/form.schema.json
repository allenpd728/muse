{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schema/form.schema.json",
  "title": "Muse form",
  "description": "Ordered sections, roles, and how material appears in them — SCHEMA_SPEC.md §2.4.",
  "type": "object",
  "required": ["sections", "order"],
  "additionalProperties": false,
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": [
              "intro", "outro", "interlude", "coda", "solo", "custom",
              "verse", "pre_chorus", "chorus", "refrain", "bridge", "hook",
              "exposition", "development", "recapitulation", "episode", "theme",
              "variation", "trio", "minuet", "scherzo", "fugue", "cadenza", "finale",
              "cue", "underscore", "stinger", "main_title", "end_credits",
              "build", "drop", "breakdown", "vamp", "groove"
            ]
          },
          "bars": { "type": "integer", "minimum": 1 },
          "uses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref"],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "$ref": "material.schema.json#/$defs/materialRef",
                  "description": "Material id, optionally with transform suffix (motif.a#seq(+2)). Resolves against material ids — checked by the harness, not the schema."
                },
                "variation": { "type": "string" }
              }
            }
          },
          "harmony": {
            "type": "string",
            "minLength": 1,
            "description": "Reference to a material.harmony.progressions id."
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "0-1 target, interpreted per-rendition."
          }
        }
      }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Section ids in performance order; repeats allowed (form is a bounded space)."
    },
    "repetition": {
      "type": "object",
      "description": "Per-section repeat bounds; min <= max is a semantic check.",
      "additionalProperties": {
        "type": "object",
        "required": ["min", "max"],
        "additionalProperties": false,
        "properties": {
          "min": { "type": "integer", "minimum": 1 },
          "max": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
